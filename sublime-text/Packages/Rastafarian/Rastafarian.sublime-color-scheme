     "foreground": "var(yellow)" }, 

        // comments: light green
        { "name": "Comments",
          "scope": "comment, punctuation.definition.comment",
          "foreground": "var(light_green)" },

        // preprocessor: light green
        { "name": "Preprocessor",
          "scope": "meta.preprocessor, meta.preprocessor keyword, keyword.control.import, keyword.control.directive, keyword.directive, punctuation.definition.preprocessor, entity.name.function.preprocessor, meta.preprocessor string, meta.preprocessor constant.numeric, meta.preprocessor punctuation, meta.preprocessor keyword.operator, constant.language.shebang.shell",
          "foreground": "var(light_green)" },

        // keywords: light red
        { "name": "Keywords",
          "scope": "keyword, keyword.control, storage, storage.type, storage.modifier, constant.language, variable.language, variable.parameter.generic, keyword.operator.word, keyword.operator.iteration, meta.statement.import.python keyword.control.import, source.cmake keyword.operator.logical",
                    "foreground": "var(light_red)" },
        { "name": "CMake function arguments reserved identifiers",
          "scope": "source.cmake keyword.operator.logical.AND.cmake, source.cmake meta.group.function.cmake meta.function-call.arguments.cmake variable.parameter.if, source.cmake meta.group.function.cmake meta.function-call.arguments.cmake variable.parameter.foreach",
                    "foreground": "var(light_red)" },

        // punctuation, numbers, parentheses/brackets, operators: light cyan
        { "name": "Punctuation",
          "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor, meta.number.integer.hexadecimal.c++ constant.numeric.base.c++",
          "foreground": "var(light_cyan)" },
        { "name": "Numbers",
          "scope": "constant.numeric, constant.numeric punctuation, meta.preprocessor.macro.c++ constant.numeric.value.c++, meta.preprocessor.macro.c++ keyword.operator.arithmetic.c",
          "foreground": "var(light_cyan)" },
        { "name": "Parentheses / brackets",
          "scope": "meta.group, meta.brackets, meta.braces, meta.parens, punctuation.section, punctuation.definition.group, punctuation.definition.parameters, punctuation.section.group, punctuation.section.parens, punctuation.section.brackets, punctuation.section.braces",
          "foreground": "var(light_cyan)" },
        { "name": "Operators",
          "scope": "keyword.operator, punctuation.separator.continuation, keyword.operator.assignment, constant.other.wildcard.asterisk, variable.language.positional, meta.function.js keyword.declaration.generator.js",
          "foreground": "var(light_cyan)" },

        // regular expressions: light magenta
        { "name": "Regex",
          "scope": "string.regexp, string.regexp keyword, string.regexp punctuation, string.regexp constant, string.regexp variable, constant.character.escape.regexp, keyword.operator.quantifier.regexp, punctuation.definition.regexp, meta.regexp",
          "foreground": "var(light_magenta)" },
        { "name": "Template strings",
          "scope": "meta.string.template.js string.quoted.other.js",
          "foreground": "var(light_magenta)" },
        
        // strings (not specified): light blue
        { "name": "Strings",
          "scope": "string, punctuation.definition.string, meta.string.js string.quoted.single.js entity.name.function.js",
          "foreground": "var(light_blue)" },
        { "name": "Escapes",
          "scope": "constant.character.escape, constant.other.placeholder",
          "foreground": "var(light_blue)" },
        { "name": "Markdown Bold",
          "font_style": "bold",
          "scope": "markup.list.unnumbered.markdown meta.paragraph.list.markdown markup.bold.markdown",
          "foreground": "#ffff00" },
        { "name": "Markdown Table", 
          "scope": "meta.table.markdown-gfm markup.bold.markdown", 
          "foreground": "var(light_magenta)" },
        { "name": "Markdown Inline", 
          "scope": "markup.bold.markdown, markup.raw.inline.markdown", 
          "foreground": "#6cf" },

        // misc
        { "name": "Invalid",
          "scope": "invalid, invalid.illegal",
          "foreground": "var(light_white)",
          "background": "var(red)" },
        { "name": "Deprecated",
          "scope": "invalid.deprecated",
          "foreground": "var(yellow)",
          "background": "var(light_red)" },

        // diff / markup
        { "name": "Diff inserted", "scope": "markup.inserted", "foreground": "var(light_green)" },
        { "name": "Diff deleted",  "scope": "markup.deleted",  "foreground": "var(light_red)" },
        { "name": "Diff changed",  "scope": "markup.changed",  "foreground": "var(light_yellow)" },
        { "name": "Headings", "scope": "markup.heading, entity.name.section", "foreground": "var(light_red)", "font_style": "bold" },
        { "name": "Bold",   "scope": "markup.bold",   "font_style": "bold" },
        { "name": "Italic", "scope": "markup.italic", "font_style": "italic" }
    ]
