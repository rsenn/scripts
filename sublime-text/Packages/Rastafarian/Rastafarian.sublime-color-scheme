  "name": "Rastafarian",

  /* Red-Yellow-Green color scheme
   *
   * has a long tradition
   */
  "author": "roman",

  /* Standard 16-color terminal (xterm) palette */
  "variables": {
    "black": "#000000",
    "red": "#e50000",
    "green": "#00e500",
    "yellow": "#e5e500",
    "blue": "#0000e5",
    "magenta": "#e500e5",
    "cyan": "#00e5e5",
    "light_gray": "#e5e5e5",
    "gray": "#7f7f7f",
    "light_red": "#ff3333",
    "light_green": "#33ff33",
    "light_yellow": "#ffff33",
    "light_blue": "#2080ff",
    "light_magenta": "#ff33ff",
    "light_cyan": "#33ffff",
    "white": "#ffffff"
  },
  "globals": {
    "foreground": "var(light_gray)",
    "background": "var(black)",
    "caret": "var(white)",
    "invisibles": "var(gray)",
    "line_highlight": "color(var(gray) alpha(0.20))",
    "selection": "color(var(white) alpha(0.25))",
    "selection_border": "var(gray)",
    "inactive_selection": "color(var(gray) alpha(0.30))",
    "misspelling": "var(light_red)",
    "shadow": "color(var(black) alpha(0.5))",
    "find_highlight": "color(var(light_magenta) alpha(0.50))",
    "find_highlight_foreground": "var(white)",
    "highlight": "var(light_cyan)",
    "accent": "var(light_green)",
    "gutter": "var(black)",
    "gutter_foreground": "var(gray)",
    "bracket_contents_foreground": "var(light_cyan)",
    "bracket_contents_options": "underline",
    "brackets_foreground": "var(light_cyan)",
    "brackets_options": "underline",
    "tags_foreground": "var(light_red)",
    "tags_options": "stippled_underline"
