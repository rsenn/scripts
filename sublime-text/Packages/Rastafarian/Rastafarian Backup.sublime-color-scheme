{
    "name": "Rastafarian",
    "author": "roman",

    // Standard 16-color terminal (xterm) palette
    "variables": {
        "black":          "#000000",
        "red":            "#ff0000",
        "green":          "#00ff00",
        "yellow":         "#ffff00",
        "blue":           "#0000ee",
        "magenta":        "#ff00ff",
        "cyan":           "#00ffff",
        "white":          "#e5e5e5",

        "light_black":    "#7f7f7f",
        "light_red":      "#ff0000",
        "light_green":    "#00ff00",
        "light_yellow":   "#ffff00",
        "light_blue":     "#2080ff",
        "light_magenta":  "#ff00ff",
        "light_cyan":     "#00ffff",
        "light_white":    "#ffffff"
    },

    "globals": {
        "foreground":           "var(white)",
        "background":           "var(black)",
        "caret":                "var(light_white)",
        "invisibles":           "var(light_black)",
        "line_highlight":       "color(var(light_black) alpha(0.20))",
        "selection":            "color(var(light_white) alpha(0.25))",
        "selection_border":     "var(light_black)",
        "inactive_selection":   "color(var(light_black) alpha(0.30))",
        "misspelling":          "var(light_red)",
        "shadow":               "color(var(black) alpha(0.5))",
        "find_highlight":       "color(var(light_magenta) alpha(0.50))",
        "find_highlight_foreground": "var(light_white)",
        "highlight":            "var(light_cyan)",
        "accent":               "var(light_green)",
        "gutter":               "var(black)",
        "gutter_foreground":    "var(light_black)",
        "bracket_contents_foreground": "var(light_cyan)",
        "bracket_contents_options":    "underline",
        "brackets_foreground":  "var(light_cyan)",
        "brackets_options":     "underline",
        "tags_foreground":      "var(light_red)",
        "tags_options":         "stippled_underline"
    },

    "rules": [
        // default for all C++ text; more specific rules below still win
        { "name": "C++ default",
          "scope": "source.c++,  entity.name.function.preprocessor.c++",
          "foreground": "var(yellow)" },
        { "name": "JS default/arguments/group/property",
          "scope": "source.js, variable.language.global.js, meta.function-call.arguments.js, meta.group.js, meta.property.object.js",
          "foreground": "var(yellow)" },
        { "name": "C default/struct/block",
          "scope": "source.c, meta.brackets.c, meta.preprocessor.c, meta.preprocessor.macro.c, source.c meta.preprocessor.macro.c, meta.struct.c, meta.block.c, meta.function.parameters.c, meta.group.c",
          "foreground": "var(yellow)" },
        // the meta.preprocessor forms outrank the "meta.preprocessor string/punctuation" (light green) rules
        { "name": "C++ #include <...>",
          "scope": "string.quoted.other.lt-gt.include.c++, meta.preprocessor string.quoted.other.lt-gt.include.c++, string.quoted.other.lt-gt.include.c, meta.preprocessor string.quoted.other.lt-gt.include.c",
          "foreground": "var(yellow)" },
        { "name": "CMake variable substitution",
          "scope": "meta.text-substitution.cmake, punctuation.definition.variable.substitution.cmake, meta.text-substitution.cmake punctuation.definition.variable.substitution.cmake, punctuation.section.braces.begin.cmake, punctuation.section.braces.end.cmake, variable.other.readwrite.cmake, meta.text-substitution.cmake variable.other.readwrite.cmake",
          "foreground": "var(light_magenta)" },
        { "name": "CMake arguments and NOT",
          "scope": "meta.function-call.arguments.cmake, keyword.operator.logical.NOT.cmake, meta.function-call.arguments.cmake keyword.operator.logical.NOT.cmake, meta.function-call.arguments, meta.string.unquoted",
          "foreground": "var(yellow)" },
        { "name": "CMake generic parameters",
          "scope": "variable.parameter.generic.cmake",
          "foreground": "var(light_red)" },
        { "name": "CMake double-quoted strings",
          "scope": "string.quoted.double.cmake, string.quoted.double.cmake, punctuation.definition.string.begin.cmake, punctuation.definition.string.end.cmake",
          "foreground": "var(light_cyan)" },
        { "name": "C++ dot accessor",
          "scope": "punctuation.accessor.dot.c++, punctuation.section.brackets.begin.c++, punctuation.section.brackets.end.c++",
          "foreground": "var(light_cyan)" },
        { "name": "C octal numbers",
          "scope": "constant.numeric.base.c, meta.number.integer.octal.c, constant.numeric.value.c, meta.number.integer.octal.c constant.numeric.value.c",
          "foreground": "var(light_cyan)" },
        { "name": "C #include keyword",
          "scope": "keyword.control.import.c, meta.preprocessor keyword.control.import.c",
          "foreground": "var(light_green)" },
        { "name": "C #include strings",
          "scope": "string.quoted.double.include.c++, meta.preprocessor string.quoted.double.include.c++, string.quoted.double.include.c, punctuation.definition.string.begin.c, punctuation.definition.string.end.c, meta.preprocessor string.quoted.double.include.c, meta.preprocessor punctuation.definition.string.begin.c, meta.preprocessor punctuation.definition.string.end.c",
          "foreground": "var(light_cyan)" },
        { "name": "JSON double-quoted strings",
          "scope": "string.quoted.double.json, punctuation.definition.string.begin.json, punctuation.definition.string.end.json",
          "foreground": "var(light_cyan)" },
        { "name": "JS arrow function",
          "scope": "keyword.declaration.function.arrow.js",
          "foreground": "var(light_cyan)" },
        { "name": "C++ cast operators",
          "scope": "keyword.operator.word.cast.c++",
          "foreground": "var(light_red)" },
        { "name": "JS new operator",
          "scope": "keyword.operator.word.new.js, keyword.operator.js",
          "foreground": "var(light_red)" },
        { "name": "JS regex",
          "scope": "string.regexp.js, string.regexp.js punctuation.definition.string.begin.js, string.regexp.js punctuation.definition.string.end.js, meta.group.regexp, constant.other.character-class.set.regexp, keyword.operator.negation.regexp",
          "foreground": "var(light_magenta)" },
        { "name": "Regex escapes and group delimiters",
          "scope": "keyword.operator.or.regexp, constant.character.escape.backslash.regexp,punctuation.definition.group.begin.regexp, punctuation.definition.group.end.regexp",
          "foreground": "var(light_magenta)" },
        { "name": "JS strings",
          "scope": "meta.string.js, string.quoted.single.js, meta.string.template.js string.quoted.other.js",
          "foreground": "var(light_cyan)" },
        { "name": "JS string quotes and interpolation",
          "scope": "punctuation.section.interpolation.begin.js, punctuation.section.interpolation.end.js, punctuation.definition.string.begin.js, punctuation.definition.string.end.js",
          "foreground": "var(light_blue)" },
        { "name": "C double-quoted strings",
          "scope": "string.quoted.double.c, string.quoted.single.c",
          "foreground": "var(light_cyan)" },
        { "name": "C++ string delimiters",
          "scope": "punctuation.definition.string.begin.c++, punctuation.definition.string.end.c++",
          "foreground": "var(light_cyan)" },
        { "name": "C++ function/block/call/group",
          "scope": "meta.brackets.c++, constant.other.variable.mac-classic.c, meta.brackets.c++ constant.other.variable.mac-classic.c,meta.function.c++, meta.block.c++, meta.function-call.c++, meta.group.c++",
          "foreground": "var(yellow)" },
        { "name": "Shell quoted strings",
          "scope": "string.quoted.double.shell, string.quoted.single.shell",
          "foreground": "var(light_cyan)" },

        // default text / identifiers: yellow
        { "name": "Identifiers",
          "scope": "variable, entity.name, entity.other, support.function, support.class, support.type, support.constant, meta.function-call, variable.function, variable.parameter, variable.other, meta.path, meta.preprocessor.macro, keyword.control.import.cmake, meta.preprocessor.c++, meta.import-source.python, meta.generic-name.python",
          "foreground": "var(yellow)" },
   { "name": "Shell patterns ",
           "scope": "meta.clause.patterns.shell, meta.string.glob.shell, string.unquoted.shell",
     "foreground": "var(yellow)" }, 

        // comments: light green
        { "name": "Comments",
          "scope": "comment, punctuation.definition.comment",
          "foreground": "var(light_green)" },

        // preprocessor: light green
        { "name": "Preprocessor",
          "scope": "meta.preprocessor, meta.preprocessor keyword, keyword.control.import, keyword.control.directive, keyword.directive, punctuation.definition.preprocessor, entity.name.function.preprocessor, meta.preprocessor string, meta.preprocessor constant.numeric, meta.preprocessor punctuation, meta.preprocessor keyword.operator, constant.language.shebang.shell",
          "foreground": "var(light_green)" },

        // keywords: light red
        { "name": "Keywords",
          "scope": "keyword, keyword.control, storage, storage.type, storage.modifier, constant.language, variable.language, variable.parameter.generic, keyword.operator.word, keyword.operator.iteration, meta.statement.import.python keyword.control.import",
          "foreground": "var(light_red)" },

        // punctuation, numbers, parentheses/brackets, operators: light cyan
        { "name": "Punctuation",
          "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor, meta.number.integer.hexadecimal.c++ constant.numeric.base.c++",
          "foreground": "var(light_cyan)" },
        { "name": "Numbers",
          "scope": "constant.numeric, constant.numeric punctuation, meta.preprocessor.macro.c++ constant.numeric.value.c++, meta.preprocessor.macro.c++ keyword.operator.arithmetic.c",
          "foreground": "var(light_cyan)" },
        { "name": "Parentheses / brackets",
          "scope": "meta.group, meta.brackets, meta.braces, meta.parens, punctuation.section, punctuation.definition.group, punctuation.definition.parameters, punctuation.section.group, punctuation.section.parens, punctuation.section.brackets, punctuation.section.braces",
          "foreground": "var(light_cyan)" },
        { "name": "Operators",
          "scope": "keyword.operator, punctuation.separator.continuation, keyword.operator.assignment, constant.other.wildcard.asterisk, variable.language.positional, meta.function.js keyword.declaration.generator.js",
          "foreground": "var(light_cyan)" },

        // regular expressions: light magenta
        { "name": "Regex",
          "scope": "string.regexp, string.regexp keyword, string.regexp punctuation, string.regexp constant, string.regexp variable, constant.character.escape.regexp, keyword.operator.quantifier.regexp, punctuation.definition.regexp, meta.regexp",
          "foreground": "var(light_magenta)" },
        { "name": "Template strings",
          "scope": "meta.string.template.js string.quoted.other.js",
          "foreground": "var(light_magenta)" },
        
        // strings (not specified): light blue
        { "name": "Strings",
          "scope": "string, punctuation.definition.string, meta.string.js string.quoted.single.js entity.name.function.js",
          "foreground": "var(light_blue)" },
        { "name": "Escapes",
          "scope": "constant.character.escape, constant.other.placeholder",
          "foreground": "var(light_blue)" },
        { "name": "Markdown Bold",
          "font_style": "bold",
          "scope": "markup.list.unnumbered.markdown meta.paragraph.list.markdown markup.bold.markdown",
          "foreground": "#ffff00" },
        { "name": "Markdown Table", 
          "scope": "meta.table.markdown-gfm markup.bold.markdown", 
          "foreground": "var(light_magenta)" },
        { "name": "Markdown Inline", 
          "scope": "markup.bold.markdown, markup.raw.inline.markdown", 
          "foreground": "#6cf" },

        // misc
        { "name": "Invalid",
          "scope": "invalid, invalid.illegal",
          "foreground": "var(light_white)",
          "background": "var(red)" },
        { "name": "Deprecated",
          "scope": "invalid.deprecated",
          "foreground": "var(black)",
          "background": "var(yellow)" },

        // diff / markup
        { "name": "Diff inserted", "scope": "markup.inserted", "foreground": "var(light_green)" },
        { "name": "Diff deleted",  "scope": "markup.deleted",  "foreground": "var(light_red)" },
        { "name": "Diff changed",  "scope": "markup.changed",  "foreground": "var(light_yellow)" },
        { "name": "Headings", "scope": "markup.heading, entity.name.section", "foreground": "var(light_red)", "font_style": "bold" },
        { "name": "Bold",   "scope": "markup.bold",   "font_style": "bold" },
        { "name": "Italic", "scope": "markup.italic", "font_style": "italic" }
    ]
}
