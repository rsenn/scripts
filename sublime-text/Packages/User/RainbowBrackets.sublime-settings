{
    "debug": false,
    "default_config": {
        "bracket_pairs": {
            "(": ")",
            "[": "]",
            "{": "}"
        },
        "coloring": false,

        "enabled": true,
        "ignored_scopes": [
            "comment",
            "string",
            "constant"
        ],
        "color.error": "#FF0000",
        "color.cycle": [
            "#0094FF",
            "#0041FF",
            "#7D00E5",
            "#FF0000",
            "#FF6A00",
            "#FFD800",
          "#00FF00",
            ],
    },
    "syntax_specific": {
        "Bash": {
            "coloring": false,
            "ignored_scopes": ["keyword"]
        },
        "JSON": {
            "coloring": true,
            "bracket_pairs": {
                "{": "}",
                "[": "]",
            },
            "extensions": [
                ".json",
                ".sublime-settings",
                ".sublime-menu",
                ".sublime-build",
                ".sublime-keymap",
                ".sublime-commands",
                ".sublime-theme",
                ".sublime-color-scheme"
            ],
            "ignored_scopes": [
                "comment", "string"
            ]
        },
        "Regular Expression": {
            "extensions": [
                ".sublime-syntax"
            ],
            "ignored_scopes": [
                "string",
                "comment",
                "constant",
                "meta.literal",
                "meta.set",
            ]
        },
        "Scheme": {
            "coloring": true,
            "bracket_pairs": {
                "(": ")",
                "[": "]",
            },
            "extensions": [
                ".c",
                ".h",
                ".cpp",
                ".hpp",
                ".js",
                ".ts",
                ".mjs",
            ],
            "ignored_scopes": [
                "comment", "string", "constant"
            ]
        }
    }
}
