{
  // watched expressions and variables in their own tab of another group (where the Outline is),
  // instead of the right half of the callstack panel; needs a window with more than one group.
  // variables_sidebar_group: group index, -1 = the last group
  "variables_sidebar": true,
  "variables_sidebar_group": -1,

  "global_debugger_configurations": [
    {
      "type": "qjs",
      // the "qjs" type is registered by User/qjs_debugger_adapter.py
      "request": "launch",
      "name": "Debug QuickJS Script",
      "program": "${file}",
      "cwd": "${folder}",
      "interpreter": "qjsm",
      "stopOnEntry": true
    },
    {
      "type": "qjs",
      "request": "launch",
      "name": "extract-c.js on a file",
      "program": "${folder}/utilities/extract-c.js",
      "args": [
        "-l",
        "${folder}/quickjs-xml.c"
      ],
      "cwd": "${folder}",
      "interpreter": "qjsm",
      "stopOnEntry": true,
      "env": {
        "QUICKJS_MODULE_PATH": "/usr/local/lib/quickjs;/usr/local/lib/x86_64-linux-gnu/quickjs"
      }
    }
  ]
}
